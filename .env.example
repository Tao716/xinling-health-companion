# Copy this file to .env. Never commit the real .env file.

# Leave empty to use the built-in offline demo responder.
LLM_API_KEY=
LLM_MODEL_TYPE=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_URL=https://api-inference.modelscope.cn/v1/

# Optional administrator account. Use a unique, strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# Runtime settings
DB_PATH=mindmate.db
HOST=127.0.0.1
PORT=7860
GRADIO_SHARE=false
